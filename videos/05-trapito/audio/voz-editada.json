{
 "duracion": 86.327,
 "segmentos": [
  {
   "s": 0.0,
   "e": 3.54,
   "texto": "¿Tuviste un trapito o un peluche sin el que no te podías dormir?"
  },
  {
   "s": 5.16,
   "e": 12.1,
   "texto": "Un pediatra inglés se lo tomó en serio, y lo que pensó explica por qué, de grandes, necesitamos el arte."
  },
  {
   "s": 13.22,
   "e": 17.32,
   "texto": "Donald Winnicott atendió bebés y madres durante casi cuarenta años."
  },
  {
   "s": 17.68,
   "e": 20.66,
   "texto": "Vio que, antes del año, muchos adoptan un objeto."
  },
  {
   "s": 21.1,
   "e": 23.86,
   "texto": "Una sábana, un pañuelo, un muñeco."
  },
  {
   "s": 23.98,
   "e": 24.78,
   "texto": "¿Para qué sirve?"
  },
  {
   "s": 25.26,
   "e": 28.84,
   "texto": "Al principio, el bebé no distingue entre él y su mamá."
  },
  {
   "s": 28.84,
   "e": 33.04,
   "texto": "De a poco descubre que ella es otra persona, que se va y vuelve."
  },
  {
   "s": 33.34,
   "e": 35.46,
   "texto": "El trapito ayuda a cruzar ese paso."
  },
  {
   "s": 36.02,
   "e": 40.88,
   "texto": "Es lo primero que siente suyo sin ser él, y que lo conecta con ella sin ser ella."
  },
  {
   "s": 41.54,
   "e": 43.9,
   "texto": "Winnicott lo llamó objeto transicional."
  },
  {
   "s": 45.26,
   "e": 46.32,
   "texto": "Y decía algo más."
  },
  {
   "s": 46.86,
   "e": 50.04,
   "texto": "Aceptar la realidad es una tarea que nunca termina."
  },
  {
   "s": 50.42,
   "e": 54.18,
   "texto": "Nadie se libra de la tensión entre el mundo de adentro y el de afuera."
  },
  {
   "s": 54.52,
   "e": 56.5,
   "texto": "Necesitamos un lugar donde descansar."
  },
  {
   "s": 57.52,
   "e": 59.7,
   "texto": "De bebés, ese lugar fue el trapito."
  },
  {
   "s": 59.7,
   "e": 63.66,
   "texto": "Con los años queda en un cajón, pero lo que hacía se extiende."
  },
  {
   "s": 64.04,
   "e": 66.52,
   "texto": "Se vuelve juego y después cultura."
  },
  {
   "s": 67.76,
   "e": 68.48,
   "texto": "Pensalo así."
  },
  {
   "s": 68.84,
   "e": 70.5,
   "texto": "Una canción la escribió otro."
  },
  {
   "s": 70.84,
   "e": 73.12,
   "texto": "Pero cuando suena, parece que habla de vos."
  },
  {
   "s": 73.56,
   "e": 75.36,
   "texto": "Viene de afuera y es tuya."
  },
  {
   "s": 75.76,
   "e": 77.28,
   "texto": "No hay que decidir de quién es."
  },
  {
   "s": 78.18,
   "e": 81.02,
   "texto": "Por eso, cuando el día pesa, ponés esa canción."
  },
  {
   "s": 81.56,
   "e": 84.64,
   "texto": "Un lugar para descansar de la tarea que nunca termina."
  }
 ],
