{
 "duracion": 45.949,
 "segmentos": [
  {
   "s": 0.0,
   "e": 4.78,
   "texto": "Te tropezás en la vereda. Antes de fijarte si te lastimaste, mirás alrededor."
  },
  {
   "s": 5.2,
   "e": 11.0,
   "texto": "¿Quién me vio? En este cuadro de Hopper hay cuatro personas. Ninguna mira para afuera."
  },
  {
   "s": 11.22,
   "e": 17.16,
   "texto": "En el año 2000, unos psicólogos hicieron entrar estudiantes a una sala con una remera ridícula."
  },
  {
   "s": 17.26,
   "e": 23.0,
   "texto": "Ellos calcularon que la había notado la mitad. La notó un cuarto. Saberlo no alcanza."
  },
  {
   "s": 23.84,
   "e": 29.74,
   "texto": "Porque la mirada que más pesa no está en la sala. No hay nadie. Y sin embargo, algo mira."
  },
  {
   "s": 29.74,
   "e": 36.94,
   "texto": "Antes de poder mirarnos, alguien nos miró. Un bebé descubre que existe en una cara que se inclina sobre él."
  },
  {
   "s": 37.28,
   "e": 42.04,
   "texto": "Quizás, cada vez que giramos la cabeza, seguimos preguntando lo mismo que entonces."
  },
  {
   "s": 42.38,
   "e": 45.76,
   "texto": "Si todavía hay alguien ahí que nos mira como aquella vez."
  }
 ],
