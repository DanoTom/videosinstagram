  {
   "s": 13.78,
   "e": 19.42,
   "texto": "como tal y puede acabar siéndolo. Y como nadie recuerda el origen de estas expresiones,"
  },
  {
   "s": 19.84,
   "e": 22.44,
   "texto": "nos terminan pareciendo naturales."
  }
